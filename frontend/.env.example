# Public Supabase client
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase admin client
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transactional email
RESEND_API_KEY=your-resend-api-key
OWNER_EMAIL=owner@example.com
FROM_EMAIL=Example Site <noreply@example.com>

# Admin authentication
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-an-admin-password

# Public Cloudinary configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Server-only Cloudinary credentials — /admin 사진 업로드와 scripts/add-photos.mjs에 필요.
# Cloudinary 콘솔 → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# 선택 — 세션 무효화와 레이트 리밋을 위한 Upstash Redis
#
# 레이트 리밋은 이게 없어도 인스턴스를 넘어 공유된다: 위의 Supabase service
# role로 `public.rate_limit_hit()`을 부른다(supabase/migrations/
# 20260928000000_rate_limits.sql — 적용 전에는 인스턴스별 in-memory로 센다).
# Upstash가 있으면 레이트 리밋은 그쪽을 먼저 쓴다.
#
# 세션 무효화는 Upstash가 없으면 in-memory라, 로그아웃이 그 인스턴스에서만
# 유효하다(세션은 8시간 뒤 어차피 만료된다).
#
# 켜는 법: Vercel Marketplace → Upstash Redis를 프로젝트에 연결하면 이 두 값이
# 자동으로 들어온다. 로컬에서 시험하려면 Upstash 콘솔에서 복사한다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
