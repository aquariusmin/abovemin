# Public Supabase client
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase admin client
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transactional email
RESEND_API_KEY=your-resend-api-key
OWNER_EMAIL=owner@example.com
FROM_EMAIL=Example Site <noreply@example.com>

# Admin authentication
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-an-admin-password

# Public Cloudinary configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Server-only Cloudinary credentials — /admin 사진 업로드와 scripts/add-photos.mjs에 필요.
# Cloudinary 콘솔 → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
